NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000

# Fresh install: leave DATABASE_URL unset/commented to launch /setup. Redis is optional.
# Existing/managed deployment: set them through your secret manager instead.
# DATABASE_URL=postgresql://framework:strong-password@localhost:5432/framework
# # Optional: enable Redis later for distributed cache/coordination.
# REDIS_URL=redis://localhost:6379

DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional on fresh install. Installer generates a strong token pepper if absent.
# AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
SESSION_DAYS=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
ALLOW_THIRD_PARTY_MODULES=false
